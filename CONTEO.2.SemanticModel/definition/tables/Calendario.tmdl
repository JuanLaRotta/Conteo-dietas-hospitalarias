		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN('REGISTRO'[FECHA Y HORA DE REGISTRO]),
				        MAX('REGISTRO'[FECHA Y HORA DE REGISTRO])
				    ),
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "MMM"),
				    "Mes Número", MONTH([Date]),
				    "Año-Mes", FORMAT([Date], "YYYY-MM"),
				    "Mes Año Texto", FORMAT([Date], "MMM YYYY"),
				    "Semana", WEEKNUM([Date],2),
				    "Día", DAY([Date])
				)

	annotation PBI_Id = 6b6ec5f352d743349034aafb88060e74

